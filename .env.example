TELEGRAM_BOT_TOKEN=
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
QWEN_API_KEY_BACKUP=
QWEN_BACKUP_BASE_URL=

# --- MODEL CONFIGURATION FOR SINGLE MARKET ANALYSIS ---
QWEN_BULL_MODEL=alims-intl/deepseek-v4-flash
QWEN_BEAR_MODEL=alims-intl/deepseek-v4-flash
QWEN_RISK_MANAGER_MODEL=alims-intl/deepseek-v4-pro

# --- MODEL CONFIGURATION FOR LEARNING/POST-MORTEM ---
QWEN_EVALUATOR_MODEL=alims-intl/deepseek-v3.2
QWEN_SHORT_MODEL=alims-intl/deepseek-v4-flash

# --- MODEL CONFIGURATION FOR MULTI-MARKET EVENT ANALYSIS ---
QWEN_SCOUT_MODEL=alims-intl/deepseek-v4-flash
QWEN_EVENT_ANALYST_MODEL=alims-intl/deepseek-v4-flash
QWEN_EVENT_FINAL_MODEL=alims-intl/deepseek-v4-pro

# Output budget split by role: 10% fast, 30% analyst, 60% final.
QWEN_MAX_TOKENS=10000
QWEN_SHORT_MAX_TOKENS=4000
QWEN_REQUEST_TIMEOUT_MS=90000
POLYMARKET_REQUEST_TIMEOUT_MS=10000

# Legacy fallback for final model if role-specific models are empty.
QWEN_MODEL=alims-intl/deepseek-v4-pro

# Polymarket APIs.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Crypto research API. Binance public market-data endpoint, no key required.
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_STABLECOINS_URL=https://stablecoins.llama.fi
FEAR_GREED_URL=https://api.alternative.me/fng/
GDELT_DOC_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Optional tuning.
WEB_PORT=8787
WEB_HOST=127.0.0.1
WEB_PASSWORD=
MAX_QWEN_INPUT_CHARS=7000
CACHE_TTL_SECONDS=60
CRYPTO_CACHE_TTL_SECONDS=10
FUNDAMENTAL_CACHE_TTL_SECONDS=900
NEWS_CACHE_TTL_SECONDS=900
RESEARCH_FETCH_TIMEOUT_MS=8000

# Anti-spam guard. Berlaku untuk Telegram dan Website.
COMMAND_COOLDOWN_MS=3000
DUPLICATE_COMMAND_COOLDOWN_MS=15000
QWEN_COMMAND_COOLDOWN_MS=45000

# Keep false in production. Only enable temporarily for a trusted TLS-inspecting proxy.
ALLOW_INSECURE_TLS=false

# Disabled until reflections can be backed by timestamped historical evidence.
ENABLE_AI_REFLECTION_MEMORY=false

# Live orders are fail-closed. Keep disabled until credentials are rotated and
# all limits below are deliberately reviewed.
ENABLE_LIVE_TRADING=false
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
MAX_TRADE_USDC=10
MAX_TRADE_BATCH_USDC=25
MAX_DAILY_TRADE_USDC=50
MAX_TRADES_PER_REQUEST=3
TRADE_SIGNAL_TTL_SECONDS=60
TRADE_MAX_PRICE=0.70
TRADE_FEE_BUFFER_CENTS=4
TRADE_MIN_SECONDS_TO_CLOSE=30
