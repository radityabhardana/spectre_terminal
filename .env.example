OMNI_API_KEY=
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# --- MODEL CONFIGURATION (OMNIROUTE - INDIVIDUAL TASK CALLS) ---
QWEN_BULL_MODEL=alims-intl/deepseek-v4-flash-0731
QWEN_BEAR_MODEL=alims-intl/deepseek-v4-flash-0731
QWEN_RISK_MANAGER_MODEL=alims-intl/deepseek-v4-pro-0813

# --- MODEL FALLBACK & SHORT SCALPER ---
# Application-level model fallback: retried only when the primary model ID fails.
# Skipped automatically when identical to the primary model; requests remain on OmniRoute.
QWEN_FALLBACK_MODEL=alims-intl/deepseek-v4-flash-0731
QWEN_SHORT_MODEL=alims-intl/deepseek-v4-flash-0731

# --- MODEL CONFIGURATION FOR POST-MORTEM / EVALUATION ---
# Reserved for post-mortem/evaluation use (wired into config; no evaluator runtime
# currently exists). Falls back to QWEN_FINAL_MODEL/QWEN_MODEL/default final model.
QWEN_EVALUATOR_MODEL=alims-intl/deepseek-v4-pro-0813

# --- MODEL CONFIGURATION FOR MULTI-MARKET EVENT ANALYSIS ---
QWEN_SCOUT_MODEL=alims-intl/deepseek-v4-flash-0731
QWEN_EVENT_ANALYST_MODEL=alims-intl/deepseek-v4-flash-0731
QWEN_EVENT_FINAL_MODEL=alims-intl/deepseek-v4-pro-0813

# Output budget split by role: 10% fast, 30% analyst, 60% final.
QWEN_MAX_TOKENS=10000
# Short-explanation budget; the runtime caps it at 1500 output tokens because the
# short explanation JSON schema is small.
QWEN_SHORT_MAX_TOKENS=4000
QWEN_REQUEST_TIMEOUT_MS=180000
SHORT_AI_TIMEOUT_MS=60000
POLYMARKET_REQUEST_TIMEOUT_MS=10000

# Legacy fallback for final model if QWEN_FINAL_MODEL is empty.
QWEN_MODEL=alims-intl/deepseek-v4-pro-0813

# Polymarket APIs.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYGON_RPC_URL=

# Crypto research API. Binance public market-data endpoint, no key required.
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
DEFILLAMA_BASE_URL=https://api.llama.fi
DEFILLAMA_STABLECOINS_URL=https://stablecoins.llama.fi
FEAR_GREED_URL=https://api.alternative.me/fng/
GDELT_DOC_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Optional tuning.
WEB_PORT=8787
WEB_HOST=127.0.0.1
WEB_PASSWORD=
MAX_QWEN_INPUT_CHARS=7000
CACHE_TTL_SECONDS=60
CRYPTO_CACHE_TTL_SECONDS=10
FUNDAMENTAL_CACHE_TTL_SECONDS=900
NEWS_CACHE_TTL_SECONDS=900
RESEARCH_FETCH_TIMEOUT_MS=8000

# Anti-spam guard. Berlaku untuk Telegram dan Website.
COMMAND_COOLDOWN_MS=3000
DUPLICATE_COMMAND_COOLDOWN_MS=15000
QWEN_COMMAND_COOLDOWN_MS=45000

# Keep false in production. Only enable temporarily for a trusted TLS-inspecting proxy.
ALLOW_INSECURE_TLS=false

# Read-only manual-entry guardrails. The application never submits orders.
ENTRY_MAX_PRICE=0.70
ENTRY_FEE_BUFFER_CENTS=4
ENTRY_MIN_SECONDS_TO_CLOSE=30

# --- BTC 15m SHORT OBSERVER (observe-only foundation; disabled by default) ---
# Leave disabled until every required value below is explicitly configured.
SHORT_OBSERVER_BTC_15M_ENABLED=
# Exact V2 BTC/USD feed ID from the official Chainlink Data Streams catalog; no default.
SHORT_OBSERVER_BTC_15M_EXPECTED_CHAINLINK_FEED_ID=
# All values are positive decimal integer milliseconds/counts; no defaults apply.
SHORT_OBSERVER_BTC_15M_DISCOVERY_INTERVAL_MS=
SHORT_OBSERVER_BTC_15M_DISCOVERY_LOOKAHEAD_MS=
SHORT_OBSERVER_BTC_15M_DISCOVERY_TIMEOUT_MS=
SHORT_OBSERVER_BTC_15M_SNAPSHOT_INTERVAL_MS=
SHORT_OBSERVER_BTC_15M_SNAPSHOT_TIMEOUT_MS=
# Resolution polling requires timeout <= interval and grace >= interval.
SHORT_OBSERVER_BTC_15M_RESOLUTION_INTERVAL_MS=
SHORT_OBSERVER_BTC_15M_RESOLUTION_TIMEOUT_MS=
SHORT_OBSERVER_BTC_15M_RESOLUTION_GRACE_MS=
SHORT_OBSERVER_BTC_15M_FREEZE_BEFORE_CLOSE_MS=
SHORT_OBSERVER_BTC_15M_LATE_START_GRACE_MS=
SHORT_OBSERVER_BTC_15M_RETRIES=
SHORT_OBSERVER_BTC_15M_RETRY_BACKOFF_MS=
SHORT_OBSERVER_BTC_15M_LEASE_TIMEOUT_MS=
SHORT_OBSERVER_BTC_15M_SHUTDOWN_TIMEOUT_MS=
